{
  "name": "polish-levels-map",
  "private": true,
  "version": "0.1.0",
  "lmVersion": 1,
  "description": "Polish Levels Map: learn Polish A1–C2, explained in English. Static site: runs from file:// and GitHub Pages without a build; npm is only for the build, tests and asset copying.",
  "scripts": {
    "build": "node tools/build.js",
    "validate": "node tools/validate.js",
    "validate:plan": "node tools/validate.js --root docs/plan",
    "test": "node tools/tests.js",
    "check:lang": "node tools/check-lang.js",
    "contrast": "node tools/contrast.js",
    "e2e": "node tools/e2e.js",
    "assets": "node tools/assets.js",
    "strip-keys": "node tools/strip-keys.js"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "gsap": "^3.15.0",
    "lucide-static": "^1.59.0"
  }
}
