      "type": "gap-fill",
      "tags": [
        "questions",
        "dlaczego"
      ],
      "context": "Why aren't you eating? — Because I'm not hungry.",
      "text": "{{1}} nie jesz? — {{2}} nie jestem głodny.",
      "gaps": [
        {
          "accepted": [
            "Dlaczego",
            "Czemu"
          ]
        },
        {
          "accepted": [
            "Bo",
            "Ponieważ"
          ]
        }
      ],
      "explanation": "Dlaczego (why; in speech also czemu) is answered with bo (because); ponieważ is more formal."
    },
