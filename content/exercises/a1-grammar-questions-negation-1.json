      ],
      "prompt": "___ mieszkasz? — W Łodzi.",
      "options": [
        "Skąd",
        "Kiedy",
        "Gdzie",
        "Jak"
      ],
      "correct": 2,
      "explanation": "The answer is a place: gdzie (where).",
      "optionNotes": [
        "Skąd means \"where from\": Z Łodzi.",
        "Kiedy means \"when\".",
        null,
        "Jak means \"how\"."
      ]
    },
    {
      "id": "a1-grammar-questions-negation-1-02",
      "type": "multiple-choice",
      "kind": "form",
      "tags": [
        "negation"
      ],
      "prompt": "Which sentence means \"Kuba isn't a doctor\"?",
      "options": [
        "Kuba jest nie lekarzem.",
        "Kuba nie jest lekarzem.",
        "Nie Kuba jest lekarzem.",
        "Kuba nie jest nie lekarzem."
      ],
      "correct": 1,
      "explanation": "Nie goes directly before the verb: nie jest.",
      "optionNotes": [
        "Nie goes before the verb, not after it.",
        null,
        "Nie Kuba means \"not Kuba\": someone else is a doctor.",
        "One nie is enough here."
      ]
    },
    {
      "id": "a1-grammar-questions-negation-1-03",
      "type": "short-answer",
      "tags": [
        "negation",
        "double-negation"
      ],
      "prompt": "Say the opposite of Rozumiem wszystko. (I understand everything.): ___ nie rozumiem.",
      "accepted": [
        "Nic"
      ],
      "explanation": "Nic (nothing) needs nie with the verb: Nic nie rozumiem."
    },
    {
      "id": "a1-grammar-questions-negation-1-04",
      "type": "reorder",
      "tags": [
        "questions",
        "word-order"
      ],
      "context": "Where does Ola work?",
      "answers": [
        "Gdzie pracuje Ola?",
        "Gdzie Ola pracuje?"
      ],
      "explanation": "The question word comes first. Both orders after it are natural."
    },
    {
      "id": "a1-grammar-questions-negation-1-05",
      "type": "find-error",
      "tags": [
        "negation",
        "double-negation"
      ],
      "tokens": [
