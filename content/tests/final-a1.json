      "id": "final-a1-01",
      "topic": "a1-cases-nominative",
      "type": "multiple-choice",
      "kind": "form",
      "prompt": "To jest ___ dom.",
      "options": [
        "nowy",
        "nowa",
        "nowe",
        "nowego"
      ],
      "correct": 0,
      "explanation": "Dom is masculine, and after to jest the phrase stays in the nominative: nowy dom.",
      "optionNotes": [
        null,
        "-a is the feminine ending: nowa praca.",
        "-e is the neuter singular ending: nowe auto.",
        "-ego is the masculine accusative of people and animals (mam nowego kolegę) and the genitive (nie mam nowego domu)."
      ]
    },
    {
      "id": "final-a1-02",
      "topic": "a1-cases-accusative",
      "type": "gap-fill",
      "text": "Lubię {{1}}.",
      "gaps": [
        {
          "accepted": [
            "zieloną herbatę"
          ],
          "hint": "(zielona herbata)"
        }
      ],
      "explanation": "Lubić takes the accusative. Feminine: the adjective -a → -ą, the noun -a → -ę."
    },
    {
      "id": "final-a1-03",
      "topic": "a1-verbs-byc",
      "type": "multiple-choice",
      "kind": "form",
      "prompt": "My ___ z Kanady.",
      "options": [
        "jesteśmy",
        "są",
        "jesteście",
        "jestem"
      ],
      "correct": 0,
      "explanation": "My (we) goes with jesteśmy.",
      "optionNotes": [
        null,
        "Są is for oni / one (they).",
        "Jesteście is for wy (you, plural).",
        "Jestem is for ja (I)."
      ]
    },
    {
      "id": "final-a1-04",
      "topic": "a1-verbs-present-conjugations",
      "type": "short-answer",
      "prompt": "Codziennie ___ gazetę. (czytać, I)",
      "accepted": [
        "czytam"
      ],
      "explanation": "Czytać follows the -am, -asz pattern: (ja) czytam, (ty) czytasz."
    },
    {
      "id": "final-a1-05",
      "topic": "a1-grammar-questions-negation",
      "type": "multiple-choice",
      "kind": "form",
      "prompt": "— ___ mieszkasz? — W Gdańsku.",
      "options": [
        "Gdzie",
        "Kiedy",
        "Kto",
        "Ile"
      ],
      "correct": 0,
      "explanation": "The answer is a place, so the question word is gdzie (where).",
      "optionNotes": [
        null,
        "Kiedy asks about time (when).",
        "Kto asks about a person (who).",
        "Ile asks about an amount (how many, how much)."
      ]
    },
    {
      "id": "final-a1-06",
      "topic": "a1-grammar-gender-of-nouns",
      "type": "multiple-choice",
      "kind": "form",
      "prompt": "___ okno jest otwarte.",
      "options": [
        "Ten",
        "Ta",
        "To",
        "Te"
      ],
      "correct": 2,
      "explanation": "Nouns ending in -o are (almost always) neuter: to okno.",
      "optionNotes": [
        "Ten is masculine: ten dom.",
        "Ta is feminine: ta kawa.",
        null,
        "Te is plural: te okna."
      ]
    },
    {
