{
  "version": 1,
  "id": "motion-verbs",
  "title": "Verbs of motion",
  "description": "Choose between one trip (iść, jechać, lecieć), a habit (chodzić, jeździć, latać) and one finished trip (pójść, pojechać, polecieć). A2 part: 25 of 40 cards; B1 and B2 add the prefixed verbs.",
  "level": "A2-B2",
  "cards": [
    {
      "id": "motion-verbs-001",
      "type": "cloze",
      "text": "Dokąd {{idziesz}} (iść / chodzić)? — Do sklepu.",
      "hint": "are you going (now, one person)",
      "en": "Where are you going? — To the shop.",
      "level": "A2",
      "tags": [
        "motion"
      ]
    },
    {
      "id": "motion-verbs-002",
      "type": "cloze",
      "text": "Często {{chodzimy}} (iść / chodzić) do kina.",
