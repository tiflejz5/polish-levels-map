      "type": "cloze",
      "text": "Pan Adam {{jeździ}} (jechać / jeździć) do pracy tramwajem.",
      "hint": "goes (every day)",
      "en": "Mr Adam goes to work by tram.",
      "level": "A2",
      "tags": [
        "motion"
      ]
    },
    {
